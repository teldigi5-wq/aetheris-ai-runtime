AETHERIS_MODE=PAPER
STARTING_BALANCE=10000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=3
MIN_SETUP_SCORE=72
SHADOW_SCAN_SECONDS=300
MAX_CORRELATED_EXPOSURE=0.82

BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_TESTNET_BASE=https://testnet.binancefuture.com
BINANCE_TESTNET_WS_BASE=wss://fstream.binancefuture.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
ENABLE_TESTNET_EXECUTION=false
BINANCE_RECV_WINDOW=10000
BINANCE_HTTP_RETRIES=3
BINANCE_RETRY_BASE_SECONDS=0.5

# v1.0 autonomous TESTNET-only controls
ENABLE_AUTONOMOUS_TESTNET=false
AUTO_START_AUTONOMOUS=false
AUTO_SCAN_SECONDS=120
AUTO_SCAN_MARKETS=12
AUTO_MIN_SCORE=82
AUTO_MIN_MTF_CONFIDENCE=72
AUTO_MAX_SPREAD_PCT=0.08
AUTO_RISK_PCT=0.0025
AUTO_MAX_NOTIONAL_PCT=0.05
AUTO_LEVERAGE=1
AUTO_MAX_POSITIONS=1
AUTO_ENTRY_COOLDOWN_SECONDS=900
AUTO_MAX_CONSECUTIVE_ERRORS=3

# Realtime TESTNET execution brain
ENABLE_EXECUTION_STREAM=true
EXECUTION_RECONCILE_SECONDS=30
EXECUTION_KEEPALIVE_SECONDS=2700

# Active TESTNET position manager
ENABLE_POSITION_MANAGER=true
MANAGER_CYCLE_SECONDS=5
MANAGER_FALLBACK_STOP_PCT=0.006
MANAGER_TP1_R=1.0
MANAGER_TP2_R=2.0
MANAGER_TRAIL_START_R=1.5
MANAGER_TRAIL_DISTANCE_R=0.75
MANAGER_TP1_FRACTION=0.40
MANAGER_TP2_FRACTION=0.30
MANAGER_REVERSAL_EXIT=false
MANAGER_REVERSAL_MIN_SCORE=82

# TESTNET validation mode
# Keep false during normal operation.
MANAGER_VALIDATION_MODE=false
MANAGER_VALIDATION_STOP_PCT=0.001
MANAGER_VALIDATION_TP1_R=0.05
MANAGER_VALIDATION_TRAIL_START_R=0.08
MANAGER_VALIDATION_TP2_R=0.10
MANAGER_VALIDATION_TRAIL_DISTANCE_R=0.03
